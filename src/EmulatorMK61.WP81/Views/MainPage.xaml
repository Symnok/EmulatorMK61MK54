<Page
    x:Class="EmulatorMK61.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource CommonBackground}">

    <Grid Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The indicator. Tap: real speed / fast, as on pmk-android. -->
        <Border x:Name="IndicatorBox" Grid.Row="0" Background="Black" Margin="6,2,6,4" Padding="6,6,4,6" Tapped="OnIndicatorTapped">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Stretch="Uniform" Height="58" HorizontalAlignment="Left">
                    <Grid>
                        <!-- The widest possible text, invisible, so the scale never changes. -->
                        <TextBlock Text="8.8.8.8.8.8.8.8.8.8.8.8." FontFamily="{StaticResource IndicatorFont}" FontSize="40" Opacity="0" />
                        <TextBlock x:Name="Display" FontFamily="{StaticResource IndicatorFont}" FontSize="40"
                                   Foreground="{StaticResource IndicatorDigits}" />
                    </Grid>
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0" Width="18">
                    <TextBlock x:Name="IndicatorF" Text="F" FontFamily="{StaticResource IndicatorFont}" FontSize="20"
                               Foreground="{StaticResource IndicatorDigits}" Opacity="0" HorizontalAlignment="Center" />
                    <TextBlock x:Name="IndicatorK" Text="K" FontFamily="{StaticResource IndicatorFont}" FontSize="20"
                               Foreground="{StaticResource IndicatorDigits}" Opacity="0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Name, power switch, angle switch. -->
        <Grid Grid.Row="1" Margin="8,0,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ModelName" Grid.Column="0" FontSize="15" Foreground="White" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Holding="OnModelNameHolding" />
            <ToggleButton x:Name="PowerSwitch" Grid.Column="1" Style="{StaticResource SwitchBox}" Content="вкл"
                          Click="OnPowerClick" Margin="0,0,14,0" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ToggleButton x:Name="AngleR" Style="{StaticResource SwitchBox}" Content="Р" Tag="0" Click="OnAngleClick" />
                <ToggleButton x:Name="AngleG" Style="{StaticResource SwitchBox}" Content="ГРД" Tag="1" Click="OnAngleClick" />
                <ToggleButton x:Name="AngleD" Style="{StaticResource SwitchBox}" Content="Г" Tag="2" Click="OnAngleClick" />
            </StackPanel>
        </Grid>

        <!-- The keyboard, built in code (MainPage.xaml.cs, KeyRows). -->
        <Grid x:Name="Keyboard" Grid.Row="2" Margin="2,0,2,4" />
    </Grid>

    <Page.BottomAppBar>
        <CommandBar ClosedDisplayMode="Minimal" Opened="OnMenuOpened">
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="MenuSpeed" Label="скорость" Click="OnMenuSpeed" />
                <AppBarButton x:Name="MenuModel" Label="модель" Click="OnMenuModel" />
                <AppBarButton x:Name="MenuRegisters" Label="регистры" Click="OnMenuRegisters" />
                <AppBarButton x:Name="MenuImport" Label="загрузить программу (txt)" Click="OnMenuImport" />
                <AppBarButton x:Name="MenuExport" Label="сохранить программу (txt)" Click="OnMenuExport" />
                <AppBarButton x:Name="MenuVibrate" Label="вибрация" Click="OnMenuVibrate" />
                <AppBarButton Label="инструкция" Click="OnMenuInstruction" />
                <AppBarButton Label="недокументированные возможности" Click="OnMenuUndocumented" />
                <AppBarButton Label="о программе" Click="OnMenuAbout" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
